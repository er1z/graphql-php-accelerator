{
    "name": "er1z/graphql_accelerator",
    "description": "Native GraphQL parser accelerator for webonyx/graphql-php",
    "type": "php-ext",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "extra": {
        "php-ext": {
            "extension-name": "graphql_accelerator",
            "support-zts": true,
            "support-nts": true,
            "build-type": "cargo",
            "os-families": ["linux", "darwin"],
            "download-url-method": ["pre-packaged-binary", "composer-default"]
        }
    }
}
